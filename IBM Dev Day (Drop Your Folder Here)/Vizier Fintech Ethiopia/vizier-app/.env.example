# Copy this file to .env and replace the placeholder locally.
# Never commit or share the real key.
OPENAI_API_KEY=your_api_key_here

# Optional: override Vizier's default model.
OPENAI_MODEL=gpt-5.4-mini

# Preferred IBM Dev Day integration. Create these in IBM Cloud/watsonx.ai.
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Replace these development values before deployment.
VIZIER_STORAGE_SECRET=replace_with_a_long_random_secret
VIZIER_PORT=8080
VIZIER_ENV=development
VIZIER_COUNTRY=Ethiopia
VIZIER_CURRENCY=ETB

# Optional compatible quote endpoint. Leave unset to use labelled demo references.
VIZIER_MARKET_URL=
